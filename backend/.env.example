# Copy to .env and adjust. Never commit real secrets.

# Database — SQLite for the demo, PostgreSQL for anything real.
DATABASE_URL=sqlite:///./elib.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/elib

# Signs the session cookie. Generate one: python -c "import secrets;print(secrets.token_urlsafe(32))"
SESSION_SECRET=dev-secret-change-me

# Where the static site's catalogue is read from (seed) and written to (publish).
CATALOGUE_SRC=./data/catalogue.json
PUBLISH_PATH=./data/catalogue.json
