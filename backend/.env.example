# Copy to .env and adjust. Never commit real secrets.

# Database — SQLite for the demo, PostgreSQL for anything real.
DATABASE_URL=sqlite:///./elib.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/elib

# Signs the session cookie. Generate one:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
SESSION_SECRET=dev-secret-change-me

# Send the session cookie only over HTTPS. Set to 1 in production.
COOKIE_SECURE=0

# No accounts are seeded. Create the admin after first start:
#   python -m app.manage create-admin --email you@example.com

# The shared Drive folder where material is kept (shown to staff as a link). Optional.
DRIVE_FOLDER_URL=

# The public library site, linked from the staff header.
PUBLIC_SITE_URL=https://kartik-h6.github.io/e-library/

# The frontend's catalogue: read to seed, written on publish.
CATALOGUE_SRC=../frontend/data/catalogue.json
PUBLISH_PATH=../frontend/data/catalogue.json
